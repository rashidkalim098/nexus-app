# Copy this file to ".env" in the same folder and fill in your own values.

# Port the API server runs on
PORT=8787

# The URL your frontend runs on (Vite dev server). Used for CORS.
FRONTEND_URL=http://localhost:5173

# Secret used to sign login tokens. Change this to any long random string.
JWT_SECRET=change_this_to_a_long_random_string

# ---- EMAIL (for real OTP codes) ----
# Leave these blank and the server will just print the code in its terminal
# (dev mode). Fill them in to actually email the code to users.
#
# Easiest option: a free Gmail account.
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Create an "App Password": https://myaccount.google.com/apppasswords
#   3. Use that 16-character password below (NOT your normal Gmail password)
#
# Any other SMTP provider (Resend, Brevo, SendGrid, Zoho, your own mail
# server, etc) also works — just fill in its SMTP host/port/user/pass.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="NEXUS <your_email@gmail.com>"

# If true, API responses include the OTP code directly (only use this while
# testing locally, before SMTP is set up). Keep this "false" once real email
# is working.
MAIL_DEBUG=true
